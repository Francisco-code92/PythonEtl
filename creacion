-- Dim País
CREATE TABLE dimpais (
  paiscode   VARCHAR(10) PRIMARY KEY,
  paisnombre VARCHAR(100) NOT NULL
);

INSERT INTO dimpais (paiscode, paisnombre) VALUES
('EC','Ecuador'),
('CO','Colombia'),
('PE','Perú');

-- Ventas
CREATE TABLE ventas (
  factid   SERIAL PRIMARY KEY,               -- o: GENERATED ALWAYS AS IDENTITY
  paiscode VARCHAR(10)   NOT NULL REFERENCES dimpais(paiscode),
  fecha    DATE          NOT NULL,
  netusd   NUMERIC(18,2) NOT NULL,
  taxusd   NUMERIC(18,2) NOT NULL
);

